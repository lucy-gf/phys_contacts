
## Testing getting Reconnect data from socialmixr (for Nick Davies)
library(contactsurveys)
library(socialmixr)
library(dplyr)
 
c_survey <- contactsurveys::download_survey("https://doi.org/10.5281/zenodo.16845074",
                                            overwrite = T)
reconnect <- load_survey(c_survey, participant_key = c("part_id", "cont_id"))
table(reconnect$participants$part_id)

polymod_dist <- socialmixr::contact_age_distribution(polymod)

reconnect_assigned <- assign_age_groups(reconnect, estimated_contact_age = polymod_dist,
                                        age_limits = seq(0, 90, 5))

c_matrix <- compute_matrix(reconnect_assigned)

matrix_plot(c_matrix$matrix)

reconnect$participants <- reconnect$participants %>% 
  select(!c(cont_id, cnt_location, cnt_age_group, cnt_ethnicity,  cnt_ses)) %>% 
  unique()
table(reconnect$participants$part_id)

polymod_dist <- socialmixr::contact_age_distribution(polymod)

reconnect_assigned <- assign_age_groups(reconnect, estimated_contact_age = polymod_dist,
                                        age_limits = seq(0, 90, 5))

c_matrix <- compute_matrix(reconnect_assigned)

matrix_plot(c_matrix$matrix)

